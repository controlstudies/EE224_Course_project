`timescale 1ns / 1ps

module tb_systolic_array;

    parameter ROW = 8;
    parameter COL = 8;
    parameter W   = 8;

    reg          clk;
    reg          rst;
    reg  [W-1:0] ain [COL-1:0];
    reg  [W-1:0] bin [ROW-1:0];
    wire [2*W-1:0] out [ROW-1:0][COL-1:0];

    // Matrices for testing: C = B_mat * A_mat
    // Note: bin[i] flows across row i, ain[k] flows down col k
    reg [W-1:0]   A_mat [ROW-1:0][COL-1:0]; // Fed into ain (top edge)
    reg [W-1:0]   B_mat [ROW-1:0][COL-1:0]; // Fed into bin (left edge)
    reg [2*W-1:0] C_golden [ROW-1:0][COL-1:0];

    // Instantiate your Unit Under Test (UUT)
    systolic_array #(
        .row(ROW),
        .col(COL),
        .w(W)
    ) uut (
        .clk(clk),
        .rst(rst),
        .ain(ain),
        .bin(bin),
        .out(out)
    );

    // 100 MHz Clock (10 ns period)
    always #5 clk = ~clk;

    integer r, c, m, t, errors;

    initial begin
        clk = 0;
        rst = 1;
        errors = 0;

        // 1. Initialize inputs and test matrices
        for (r = 0; r < ROW; r = r + 1) begin
            bin[r] = 0;
            ain[r] = 0;
            for (c = 0; c < COL; c = c + 1) begin
                B_mat[r][c] = (r + 1);       // Row matrix values
                A_mat[r][c] = (c + 1);       // Col matrix values
                C_golden[r][c] = 0;
            end
        end

        // 2. Compute expected golden result: C[i][k] = sum_m( B_mat[i][m] * A_mat[m][k] )
        for (r = 0; r < ROW; r = r + 1) begin
            for (c = 0; c < COL; c = c + 1) begin
                for (m = 0; m < ROW; m = m + 1) begin
                    C_golden[r][c] = C_golden[r][c] + (B_mat[r][m] * A_mat[m][c]);
                end
            end
        end

        // Release reset
        #15 rst = 0;

        // 3. Feed diagonally skewed data over (3*N - 2) cycles + margin
        for (t = 0; t < (3 * ROW); t = t + 1) begin
            @(negedge clk); // Drive inputs cleanly before posedge clk
            
            // Skew bin (rows): row r is delayed by r cycles
            for (r = 0; r < ROW; r = r + 1) begin
                if (t >= r && (t - r) < COL)
                    bin[r] = B_mat[r][t - r];
                else
                    bin[r] = 0;
            end

            // Skew ain (cols): col c is delayed by c cycles
            for (c = 0; c < COL; c = c + 1) begin
                if (t >= c && (t - c) < ROW)
                    ain[c] = A_mat[t - c][c];
                else
                    ain[c] = 0;
            end
        end

        @(negedge clk);
        for (r = 0; r < ROW; r = r + 1) begin
            bin[r] = 0;
            ain[r] = 0;
        end

        #20;

        // 4. Verify hardware output against golden result
        $display("\n--- Systolic Array 8x8 Output Matrix ---");
        for (r = 0; r < ROW; r = r + 1) begin
            for (c = 0; c < COL; c = c + 1) begin
                $write("%4d ", out[r][c]);
                if (out[r][c] !== C_golden[r][c]) begin
                    errors = errors + 1;
                end
            end
            $write("\n");
        end

        if (errors == 0)
            $display("\nSUCCESS: All 64 PE outputs match the golden matrix multiplication!");
        else
            $display("\nERROR: Found %0d mismatches.", errors);

        $finish;
    end

endmodule